<?xml version="1.0" encoding="utf-8"?>
<!--
  Temporary, for the agent-skills branch only: Devolutions.AgentSkills is not on nuget.org yet.
  The Devolutions.AgentSkills reference in UniGetUI.PackageEngine.Managers.Skills.csproj names the
  skills-manager commit to build, as 0.1.0-local.<commit>. From a checkout of that commit of
  https://github.com/mamoreau-devolutions/skills-manager, run

    dotnet pack dotnet/lib/Devolutions.AgentSkills -c Release -p:Version=0.1.0-local.<commit> -o <UniGetUI>/.local-packages

  and delete this file and the .local-packages folder once the package is published.
-->
<configuration>
  <packageSources>
    <add key="local-agentskills" value=".local-packages" />
  </packageSources>
</configuration>
