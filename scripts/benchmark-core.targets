<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'UniGetUI.Avalonia'">
    <PackageReference Remove="Devolutions.AvaloniaTheme.Linux;Devolutions.AvaloniaTheme.MacOS;Devolutions.UniGetUI.Elevator" />
    <Content Remove="@(Content)" />
    <Compile Include="**/*.cs"
             Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);$(BaseIntermediateOutputPath)**;$(BaseOutputPath)**;@(Compile)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'UniGetUI.Avalonia'">
    <ApplicationManifest>$(MSBuildProjectDirectory)\app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);MVVMTK0045;AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'UniGetUI.Avalonia' or '$(MSBuildProjectName)' == 'UniGetUI.Interface.IpcApi'">
    <Compile Remove="Generated Files\Secrets.Generated.cs;$(IntermediateOutputPath)Generated Files\Secrets.Generated.cs" />
    <Compile Include="$(BenchmarkGeneratedSources)\$(MSBuildProjectName)\Secrets.Generated.cs" />
  </ItemGroup>

  <!-- Both hosts consume the same Windows-generated sources; no shell/codegen work is timed. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild"
          Condition="'$(MSBuildProjectName)' == 'UniGetUI.Avalonia' or '$(MSBuildProjectName)' == 'UniGetUI.Interface.IpcApi'">
    <Error Condition="!Exists('$(BenchmarkGeneratedSources)\$(MSBuildProjectName)\Secrets.Generated.cs')"
           Text="The shared benchmark generated sources are missing for $(MSBuildProjectName)." />
  </Target>
  <Target Name="EnsureBundledElevatorFromNuGet" />

  <Target Name="BenchmarkUseSharedSdkAnalyzers" BeforeTargets="BenchmarkRecordCompilerInputs">
    <ItemGroup>
      <_BenchmarkHostSdkAnalyzer Include="@(Analyzer)"
          Condition="$([System.String]::Copy('%(Analyzer.FullPath)').StartsWith('$(MSBuildSDKsPath)'))">
        <SharedPath>$([MSBuild]::MakeRelative('$(MSBuildSDKsPath)', '%(Analyzer.FullPath)'))</SharedPath>
      </_BenchmarkHostSdkAnalyzer>
      <Analyzer Remove="@(_BenchmarkHostSdkAnalyzer)" />
      <Analyzer Include="@(_BenchmarkHostSdkAnalyzer->'$(BenchmarkSharedSdkAnalyzers)\%(SharedPath)')" />
    </ItemGroup>
  </Target>

  <Target Name="BenchmarkRecordCompilerInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(BenchmarkPhase)' == 'NativePublish' and !Exists('$(IntermediateOutputPath)$(TargetName).dll')"
           Text="The native benchmark requires an existing managed assembly." />
    <ItemGroup>
      <_BenchmarkInput Include="@(Compile->'source|%(FullPath)');@(ReferencePathWithRefAssemblies->'reference|%(FullPath)');@(Analyzer->'analyzer|%(FullPath)');@(AdditionalFiles->'additional|%(FullPath)');@(EmbeddedResource->'resource|%(FullPath)');@(AvaloniaResource->'resource|%(FullPath)')" />
      <_BenchmarkInput Include="resource|$(ApplicationManifest)" Condition="Exists('$(ApplicationManifest)')" />
      <_BenchmarkInput Include="resource|$(MSBuildProjectDirectory)\$(ApplicationIcon)" Condition="Exists('$(ApplicationIcon)')" />
      <_BenchmarkDefine Include="$(DefineConstants)" />
      <_BenchmarkInput Include="@(_BenchmarkDefine->'flags|define=%(Identity)')" />
      <_BenchmarkInput Include="flags|lang=$(LangVersion);flags|nullable=$(Nullable);flags|optimize=$(Optimize);flags|unsafe=$(AllowUnsafeBlocks);flags|output=$(OutputType);flags|framework=$(TargetFramework);flags|runtime=$(RuntimeIdentifier);flags|debug=$(DebugType);flags|deterministic=$(Deterministic)" />
    </ItemGroup>
    <MakeDir Directories="$(BenchmarkInputDirectory)" />
    <WriteLinesToFile File="$(BenchmarkInputDirectory)\$(MSBuildProjectName).inputs"
                      Lines="@(_BenchmarkInput)" Overwrite="true" />
  </Target>
</Project>
