<dialogs:ImmersiveDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:UniGetUI.Avalonia.Views.DialogPages"
        x:Class="UniGetUI.Avalonia.Views.DialogPages.MissingDependencyDialog"
        MaxWidth="560"
        MinHeight="230"

        Background="{DynamicResource AppDialogBackground}">

    <Grid Margin="20"
          RowDefinitions="Auto,Auto"
          RowSpacing="12">

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Name="DescBlock"
                       TextWrapping="Wrap"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="InfoBlock"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       FontStyle="Italic"
                       Opacity="0.7"/>
            <TextBlock x:Name="CommandInfoBlock"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"
                       Opacity="0.7"/>
            <SelectableTextBlock x:Name="CommandBlock"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,4"
                                 FontFamily="Consolas"
                                 Opacity="0.7"/>
            <Border x:Name="OutputBorder"
                    IsVisible="False"
                    Margin="0,0,0,4"
                    Padding="8,6"
                    CornerRadius="4"
                    Background="{DynamicResource AppDialogSubtleBackground}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}">
                <ScrollViewer MaxHeight="120"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock x:Name="OutputBlock"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Opacity="0.8"/>
                </ScrollViewer>
            </Border>
            <CheckBox x:Name="DontShowCheck"
                      IsVisible="False"/>
            <ProgressBar x:Name="ProgressBar"
                         IsIndeterminate="False"
                         IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="SkipButton"
                    MinWidth="110"/>
            <Button x:Name="InstallButton"
                    MinWidth="140"
                    Classes="accent"/>
        </StackPanel>

    </Grid>

</dialogs:ImmersiveDialog>
