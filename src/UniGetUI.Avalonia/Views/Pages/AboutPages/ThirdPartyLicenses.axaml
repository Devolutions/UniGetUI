<UserControl x:Class="UniGetUI.Avalonia.Views.Pages.AboutPages.ThirdPartyLicenses"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:vm="using:UniGetUI.Avalonia.ViewModels.Pages.AboutPages"
             xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:DataType="vm:ThirdPartyLicensesViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Spacing="4" Margin="16,8">

            <TextBlock Text="{t:Translate UniGetUI License}"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="{t:Translate Text='Using UniGetUI implies the acceptation of the MIT License'}"
                       FontSize="14"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{t:Translate Third-party licenses}"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,10,0,0"/>

            <TextBlock Text="{Binding LicensesIntro}"
                       FontSize="14"
                       TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0"
                           Text="{Binding ComponentCountText}"
                           IsVisible="{Binding HasLicenses}"
                           FontSize="14"
                           Opacity="0.75"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="0"
                           Text="{Binding MissingNoticesText}"
                           IsVisible="{Binding !HasLicenses}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Command="{Binding OpenNoticesFileCommand}"
                        IsVisible="{Binding CanOpenNoticesFile}"
                        Content="{t:Translate Open the full notices file}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Licenses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThirdPartyComponentItem">
                        <StackPanel Orientation="Vertical" Margin="0,2">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" MinHeight="32">
                                <TextBlock Grid.Column="0"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Version}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding License}"
                                           FontSize="14"
                                           MaxWidth="260"
                                           Margin="12,0"
                                           Opacity="0.75"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding License}"/>
                                <Button Grid.Column="2"
                                        Command="{Binding OpenSourceCommand}"
                                        IsVisible="{Binding HasSource}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        ToolTip.Tip="{Binding SourceUrl}"
                                        automation:AutomationProperties.Name="{t:Translate Source}">
                                    <TextBlock Classes="hyperlink"
                                               FontSize="14"
                                               Text="{t:Translate Source}"
                                               automation:AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                                <Button Grid.Column="3"
                                        Command="{Binding ToggleLicenseCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        automation:AutomationProperties.Name="{Binding ToggleText}">
                                    <TextBlock Classes="hyperlink"
                                               FontSize="14"
                                               Text="{Binding ToggleText}"
                                               automation:AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                            </Grid>
                            <SelectableTextBlock Text="{Binding ExpandedText}"
                                                 IsVisible="{Binding IsExpanded}"
                                                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 Margin="8,4,8,12"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
