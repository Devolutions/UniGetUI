<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:UniGetUI.Avalonia.Views.Controls"
        x:Class="UniGetUI.Avalonia.Assets.Styles.MacGlassControlStyles">
    <!-- macOS menu geometry for the glass look: popups are separate visual roots, so these are
         app-level and merged only while MacGlassWindowHelper.IsGlassEnabled(). -->

    <Style Selector="MenuFlyoutPresenter, ContextMenu">
        <Setter Property="Background" Value="{DynamicResource MacGlassMenuBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MacGlassPanelBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource MacGlassMenuCornerRadius}"/>
        <Setter Property="Padding" Value="0,5"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem, ContextMenu MenuItem">
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="Padding" Value="8,2,8,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator">
        <Setter Property="Margin" Value="14,5"/>
    </Style>
    <!-- Highlighted rows take the accent content colour on the accent fill, as in native menus. -->
    <Style Selector="MenuItem:pointerover controls|SvgIcon, MenuItem:selected controls|SvgIcon, ComboBoxItem:pointerover controls|SvgIcon">
        <Setter Property="Foreground" Value="{DynamicResource MacAccentForeground}"/>
    </Style>

    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource MacGlassMenuBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MacGlassPanelBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource MacGlassMenuCornerRadius}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="Padding" Value="8,2,8,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Push buttons: flat fill, no border; the radius goes on the template part with a state
         selector so it wins over the radius each button sets in markup. -->
    <Style Selector="Button.secondary-action, Button.dropdown-trigger">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.secondary-action:pointerover, Button.dropdown-trigger:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
    </Style>
    <Style Selector="Button.secondary-action:pressed, Button.dropdown-trigger:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/>
    </Style>
    <Style Selector="Button.secondary-action:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary-action:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.dropdown-trigger:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     Button.dropdown-trigger:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.accent:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <!-- SvgIcon only honours state-style (or local) colours, hence the :not(:disabled) activators. -->
    <Style Selector="Button.accent:not(:disabled) controls|SvgIcon">
        <Setter Property="Foreground" Value="{DynamicResource MacAccentForeground}"/>
    </Style>

    <!-- Toolbar, after Finder: icon-only buttons grouped on glass capsules (one per run between
         separators), a compact 36px height, and the main action as an accent capsule. -->
    <Style Selector="Window.mac-glass controls|ToolbarOverflowPanel#ToolBar">
        <Setter Property="AlwaysCollapseLabels" Value="True"/>
        <Setter Property="GroupBackground" Value="{DynamicResource MacGlassControlBackground}"/>
        <Setter Property="GroupBorderBrush" Value="{DynamicResource MacGlassPanelBorderBrush}"/>
        <Setter Property="GroupCornerRadius" Value="18"/>
        <Setter Property="GroupVerticalInset" Value="2"/>
    </Style>
    <Style Selector="#ToolbarRow Separator">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="#ToolbarRow Button:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     #ToolbarRow Button:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     #ToolbarRow ToggleButton:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     #ToolbarRow ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>
    <!-- Grouped buttons sit inside a capsule with a 1px rim; keep their highlight inside that rim. -->
    <Style Selector="controls|ToolbarOverflowPanel#ToolBar Button:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     controls|ToolbarOverflowPanel#ToolBar Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="1,3"/>
    </Style>
    <!-- A dropdown in a group (e.g. the catalog selector) blends into the capsule the same way. -->
    <Style Selector="controls|ToolbarOverflowPanel#ToolBar ComboBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Margin" Value="1,3"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button#MainToolbarButton:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     Button#MainToolbarButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="18,0,0,18"/>
    </Style>
    <Style Selector="Button#MainToolbarButtonDropdown:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     Button#MainToolbarButtonDropdown:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0,18,18,0"/>
    </Style>
    <Style Selector="Button#MainToolbarButton.standalone:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter,
                     Button#MainToolbarButton.standalone:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="18"/>
    </Style>
    <Style Selector="#ToolbarRow ToggleButton:not(:disabled), #ToolbarRow ToggleButton:disabled">
        <Setter Property="Background" Value="{DynamicResource MacGlassControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MacGlassPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button#MainToolbarButton:not(:disabled), Button#MainToolbarButtonDropdown:not(:disabled)">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource MacAccentForeground}"/>
    </Style>
    <Style Selector="Button#MainToolbarButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button#MainToolbarButtonDropdown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}"/>
        <Setter Property="Foreground" Value="{DynamicResource MacAccentForeground}"/>
    </Style>
    <Style Selector="Button#MainToolbarButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button#MainToolbarButtonDropdown:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource MacAccentForeground}"/>
    </Style>
    <Style Selector="Button#MainToolbarButton:not(:disabled) controls|SvgIcon">
        <Setter Property="Foreground" Value="{DynamicResource MacAccentForeground}"/>
    </Style>

    <!-- Switches: a large white knob that keeps its size in every state. -->
    <Style Selector="ToggleSwitch:not(:disabled) /template/ Ellipse#SwitchKnobOff,
                     ToggleSwitch:disabled /template/ Ellipse#SwitchKnobOff,
                     ToggleSwitch:not(:disabled) /template/ Ellipse#SwitchKnobOn,
                     ToggleSwitch:disabled /template/ Ellipse#SwitchKnobOn">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- macOS switches carry no Enabled/Disabled caption next to them. -->
    <Style Selector="TextBlock.toggle-state-label">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
        <Setter Property="Fill" Value="White"/>
    </Style>

    <!-- Pop-up buttons show up/down arrows; scroll bars have no arrow buttons. -->
    <Style Selector="ComboBox:not(:disabled) /template/ PathIcon#DropDownGlyph,
                     ComboBox:disabled /template/ PathIcon#DropDownGlyph">
        <Setter Property="Data" Value="M0,5 L4,0 L8,5 Z M0,8 L4,13 L8,8 Z"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="13"/>
    </Style>
    <!-- The hero search field gets the accent focus border instead of the WinUI underline. -->
    <Style Selector="Border#MegaQueryUnderline">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                     ScrollBar /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
</Styles>
