<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniGetUI.Avalonia.ViewModels.Pages"
             xmlns:plugins="using:UniGetUI.Extensions.AgentSkills"
             xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             x:Class="UniGetUI.Avalonia.Views.Pages.AgentPluginsControl"
             x:DataType="vm:AgentPluginsViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://UniGetUI/Views/Pages/AgentLibraryStyles.axaml"/>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{t:Translate Agent}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="PluginProvider" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelectProvider}" SelectionChanged="ProviderChanged" MinWidth="180"
                          automation:AutomationProperties.Name="{t:Translate Plugin agent}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="plugins:IAgentPluginService"><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="{Binding ProviderSummary}" Classes="secondary" TextWrapping="Wrap" ToolTip.Tip="{Binding Guidance}"/>
        </StackPanel>
        <Grid Grid.Row="1" x:Name="PluginWorkspace" ColumnDefinitions="*,0">
            <Grid x:Name="PluginLibrary" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                <WrapPanel ItemSpacing="12" LineSpacing="8">
                    <TabStrip x:Name="PluginViews" Classes="library-tabs" SelectedIndex="{Binding ViewIndex, Mode=TwoWay}"
                              IsEnabled="{Binding CanWork}" IsVisible="{Binding !IsAppHandoff}" automation:AutomationProperties.Name="{t:Translate Plugin views}">
                        <TabStripItem Content="{t:Translate Browse}"/>
                        <TabStripItem Content="{Binding InstalledHeader}"/>
                    </TabStrip>
                    <Button Content="{t:Translate Add marketplace}" Command="{Binding ShowAddMarketplaceCommand}" IsEnabled="{Binding CanWork}"/>
                    <DropDownButton x:Name="PluginMoreActions" Content="{t:Translate More actions}" IsEnabled="{Binding CanWork}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{t:Translate Marketplaces}" Command="{Binding ManageMarketplacesCommand}"
                                          IsVisible="{Binding !IsAppHandoff}"/>
                                <MenuItem Header="{t:Translate Install by identifier}" Command="{Binding ShowInstallIdentifierCommand}"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </WrapPanel>
                <StackPanel Grid.Row="1" Spacing="8">
                    <Border Classes="library-surface" Padding="12" IsVisible="{Binding AddingMarketplace}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{t:Translate Add a marketplace for the selected agent}" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox x:Name="MarketplaceInput" Text="{Binding MarketplaceInput, Mode=TwoWay}" IsEnabled="{Binding CanWork}"
                                         PlaceholderText="{t:Translate Repository or Git URL}" KeyDown="MarketplaceKeyDown"
                                         automation:AutomationProperties.Name="{t:Translate Plugin marketplace source}"/>
                                <Button Grid.Column="1" Content="{Binding MarketplaceActionLabel}" Classes="accent"
                                        Command="{Binding AddMarketplaceCommand}" IsEnabled="{Binding CanChange}"/>
                                <Button Grid.Column="2" Content="{t:Translate Open in Copilot app}"
                                        Command="{Binding OpenMarketplaceInCopilotAppCommand}" IsVisible="{Binding ShowCopilotAppFallback}"
                                        IsEnabled="{Binding CanOpenCopilotApp}"/>
                            </Grid>
                            <TextBlock Text="{t:Translate A marketplace lists plugins. Adding it does not install its plugins.}" Classes="secondary" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="library-surface" Padding="12" IsVisible="{Binding AddingPlugin}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox x:Name="PluginInput" Text="{Binding PluginInput, Mode=TwoWay}" IsEnabled="{Binding CanWork}"
                                     PlaceholderText="{t:Translate name@marketplace or /plugin install command}" KeyDown="IdentifierKeyDown"
                                     automation:AutomationProperties.Name="{t:Translate Plugin to install}"/>
                            <Button Grid.Column="1" Content="{Binding InstallActionLabel}" Command="{Binding InstallByIdCommand}" IsEnabled="{Binding CanChange}"/>
                            <Button Grid.Column="2" Content="{t:Translate Open in Copilot app}"
                                    Command="{Binding OpenPluginInCopilotAppCommand}" IsVisible="{Binding ShowCopilotAppFallback}"
                                    IsEnabled="{Binding CanOpenCopilotApp}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding !IsAppHandoff}">
                    <TextBox x:Name="PluginSearch" Text="{Binding Query, Mode=TwoWay}" Width="220" PlaceholderText="{t:Translate Filter plugins}"
                             automation:AutomationProperties.Name="{t:Translate Filter plugins}"/>
                    <ComboBox ItemsSource="{Binding Marketplaces}" SelectedItem="{Binding SelectedMarketplace, Mode=TwoWay}"
                              IsEnabled="{Binding CanWork}" MaxWidth="220" MinWidth="150" PlaceholderText="{t:Translate All marketplaces}"
                              automation:AutomationProperties.Name="{t:Translate Filter by marketplace}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="plugins:AgentPluginMarketplace"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{t:Translate Clear filter}" Command="{Binding AllMarketplacesCommand}" IsVisible="{Binding HasMarketplaceFilter}"/>
                    <Button Content="{Binding BrowseSelectedLabel}" Command="{Binding BrowseSelectedMarketplaceCommand}"
                            IsVisible="{Binding ShowBrowseSelected}" IsEnabled="{Binding CanChange}"/>
                    <Button Content="{Binding BrowseAllLabel}" Command="{Binding BrowseAllMarketplacesCommand}"
                            IsVisible="{Binding ShowBrowseAll}" IsEnabled="{Binding CanChange}"/>
                    <Button Content="{t:Translate Reload list}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanWork}"/>
                    <Button x:Name="UpdateAllPluginsButton" Content="{Binding UpdateAllLabel}" Command="{Binding UpdateAllCommand}"
                            Classes="accent" IsVisible="{Binding ShowUpdateAll}" IsEnabled="{Binding CanUpdateAll}"
                            ToolTip.Tip="{t:Translate Run Update for the shown installed plugins. Newer versions have not been verified.}"/>
                </WrapPanel>
                <Border Grid.Row="3" Classes="library-surface" IsVisible="{Binding !IsAppHandoff}">
                    <Panel>
                        <ListBox x:Name="PluginList" Classes="library" ItemsSource="{Binding Plugins}"
                                 SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}" KeyDown="PluginListKeyDown"
                                 automation:AutomationProperties.Name="{t:Translate Plugins}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="plugins:AgentPluginItem">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <Button Classes="item-title"
                                                    Command="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).OpenDetailsCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                            <TextBlock Text="{Binding Description}" Classes="description"/>
                                            <TextBlock Text="{Binding Marketplace}" Classes="secondary" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MaxWidth="160">
                                            <Border Classes="item-status" ToolTip.Tip="{Binding Notice}">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                        <Binding Path="!IsInstalled"/>
                                                        <Binding Path="!CanToggle"/>
                                                        <Binding Path="!$parent[ListBox].((vm:AgentPluginsViewModel)DataContext).SupportsToggle"/>
                                                        <Binding Path="StatusText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                                            </Border>
                                            <Button Content="{t:Translate Install}" IsVisible="{Binding ShowInstall}"
                                                    Command="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).InstallItemCommand}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).CanChange}"
                                                    automation:AutomationProperties.HelpText="{Binding Name}"/>
                                            <StackPanel Spacing="6" IsVisible="{Binding IsInstalled}"
                                                        IsEnabled="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).CanChange}">
                                                <StackPanel IsVisible="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).SupportsToggle}">
                                                    <ToggleSwitch x:Name="PluginEnabledToggle" IsVisible="{Binding CanToggle}"
                                                                  IsChecked="{Binding Enabled, Mode=OneWay}" Click="PluginEnabledClicked"
                                                                  OnContent="{t:Translate Enabled}" OffContent="{t:Translate Disabled}"
                                                                  automation:AutomationProperties.Name="{Binding Name}"
                                                                  automation:AutomationProperties.HelpText="{Binding Notice}"
                                                                  ToolTip.Tip="{Binding Notice}"/>
                                                </StackPanel>
                                                <WrapPanel IsVisible="{Binding CanManage}" ItemSpacing="6" LineSpacing="6">
                                                    <Button x:Name="UpdatePluginRowButton" Content="{t:Translate Update}"
                                                            IsVisible="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).SupportsUpdate}"
                                                            Command="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).UpdateItemCommand}"
                                                            CommandParameter="{Binding}" automation:AutomationProperties.HelpText="{Binding Name}"/>
                                                    <Button x:Name="UninstallPluginRowButton" Content="{t:Translate Uninstall}"
                                                            Command="{Binding $parent[ListBox].((vm:AgentPluginsViewModel)DataContext).UninstallItemCommand}"
                                                            CommandParameter="{Binding}" automation:AutomationProperties.HelpText="{Binding Name}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel IsVisible="{Binding ShowBrowsePrompt}" Margin="24" Spacing="10" MaxWidth="500" HorizontalAlignment="Left">
                            <TextBlock Text="{t:Translate Browse plugins by marketplace}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding BrowsePrompt}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding ShowEmpty}" Margin="24" Spacing="10" MaxWidth="500" HorizontalAlignment="Left">
                            <TextBlock Text="{t:Translate No plugins to show}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{t:Translate Clear your filters or add a marketplace to browse plugins for this agent.}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ProgressBar Height="3" IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsWorking}"/>
                    </Panel>
                </Border>
                <StackPanel Grid.Row="3" Spacing="12" MaxWidth="680" HorizontalAlignment="Left" IsVisible="{Binding IsAppHandoff}">
                    <TextBlock Text="{t:Translate Continue in the Copilot app}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap"/>
                    <TextBlock Classes="secondary" Text="{t:Translate Text='To manage plugins here instead, select GitHub Copilot.'}" TextWrapping="Wrap"/>
                </StackPanel>
                <DockPanel Grid.Row="4" IsVisible="{Binding !IsAppHandoff}">
                    <Button DockPanel.Dock="Right" Content="{Binding LoadMoreLabel}" Command="{Binding LoadMoreCommand}"
                            IsVisible="{Binding CanLoadMore}"/>
                    <TextBlock Text="{Binding ResultCount}" Classes="secondary" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
            <Border x:Name="PluginDetailsPane" Classes="library-surface" Padding="16" IsVisible="{Binding ShowDetails}">
                <Grid x:Name="PluginDetails" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Button x:Name="PluginBackButton" Content="{t:Translate Back to plugins}" Command="{Binding BackCommand}" HorizontalAlignment="Left" IsEnabled="{Binding CanWork}"/>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedPlugin.Name}"
                                   automation:AutomationProperties.HeadingLevel="2"/>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button x:Name="InstallPluginButton" Content="{t:Translate Install}" Classes="accent"
                                    Command="{Binding InstallCommand}" IsVisible="{Binding ShowInstallAction}" IsEnabled="{Binding CanInstall}"/>
                            <Button Content="{t:Translate Update}" Command="{Binding UpdateCommand}" IsVisible="{Binding ShowUpdateAction}" IsEnabled="{Binding CanUpdate}"/>
                            <Button Content="{t:Translate Enable}" Command="{Binding EnableCommand}" IsVisible="{Binding ShowEnableAction}" IsEnabled="{Binding CanEnable}"/>
                            <Button Content="{t:Translate Disable}" Command="{Binding DisableCommand}" IsVisible="{Binding ShowDisableAction}" IsEnabled="{Binding CanDisable}"/>
                            <Button Content="{t:Translate Uninstall}" Command="{Binding UninstallCommand}" IsVisible="{Binding ShowUninstallAction}" IsEnabled="{Binding CanManage}"/>
                            <Button Content="{t:Translate Install in Copilot app}" Command="{Binding OpenPluginInCopilotAppCommand}"
                                    IsVisible="{Binding ShowOpenPluginInApp}" IsEnabled="{Binding CanOpenCopilotApp}"/>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Left" Margin="0,0,12,16">
                            <TextBlock Text="{Binding SelectedPlugin.Description}" TextWrapping="Wrap"/>
                            <Border Classes="item-status"><TextBlock Text="{Binding SelectedPlugin.Status}" TextWrapping="Wrap"/></Border>
                            <TextBlock Text="{Binding SelectedPlugin.Notice}" IsVisible="{Binding SelectedPlugin.HasNotice}" TextWrapping="Wrap"/>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{t:Translate Plugin identifier}" FontWeight="SemiBold"/>
                                <SelectableTextBlock Text="{Binding SelectedPlugin.Id}" TextWrapping="Wrap"/>
                                <TextBlock Text="{t:Translate Version}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedPlugin.Version}" TextWrapping="Wrap"/>
                                <TextBlock Text="{t:Translate Marketplace}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedPlugin.Marketplace}" TextWrapping="Wrap"/>
                                <SelectableTextBlock Text="{Binding SelectedSource}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" IsVisible="{Binding ShowMarketplaces}">
            <Button x:Name="MarketplacesBackButton" Content="{t:Translate Back to plugins}" Command="{Binding BackCommand}" HorizontalAlignment="Left" IsEnabled="{Binding CanWork}"/>
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="{t:Translate Plugin marketplaces}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap"/>
            </StackPanel>
            <ListBox Grid.Row="2" Classes="library" ItemsSource="{Binding Marketplaces}"
                     SelectedItem="{Binding SelectedMarketplace, Mode=TwoWay}" automation:AutomationProperties.Name="{t:Translate Plugin marketplaces}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="plugins:AgentPluginMarketplace">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Source}" TextWrapping="Wrap"/>
                            <TextBlock Text="{t:Translate Managed by the agent}" Classes="secondary" IsVisible="{Binding !CanManage}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="3" ItemSpacing="8" LineSpacing="8">
                <Button Content="{t:Translate Refresh marketplace}" Command="{Binding RefreshMarketplaceCommand}" IsEnabled="{Binding CanRefreshMarketplace}"/>
                <Button Content="{t:Translate Remove marketplace}" Command="{Binding RemoveMarketplaceCommand}" IsEnabled="{Binding CanRemoveMarketplace}"/>
            </WrapPanel>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="6">
            <Border Classes="library-error" IsVisible="{Binding HasError}"><TextBlock Text="{Binding Status}" MaxLines="3"/></Border>
            <TextBlock Text="{Binding RestartNotice}" IsVisible="{Binding ShowRestartNotice}" TextWrapping="Wrap" Classes="secondary"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{t:Translate Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsWorking}"/>
                <Button DockPanel.Dock="Right" Content="{t:Translate Reload list}" Command="{Binding RefreshCommand}" IsVisible="{Binding CanRetry}"/>
                <TextBlock Text="{Binding Status}" IsVisible="{Binding !HasError}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}"
                           VerticalAlignment="Center" automation:AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
            <Expander Header="{t:Translate View activity}" IsVisible="{Binding HasActivity}" HorizontalAlignment="Stretch">
                <ScrollViewer MaxHeight="120"><SelectableTextBlock Text="{Binding Activity}" TextWrapping="Wrap" Margin="8"/></ScrollViewer>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
