<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.library-surface">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBox.library">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.library ListBoxItem">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style Selector="ListBox.library ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.library ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.description">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxLines" Value="1"/>
    </Style>
    <Style Selector="Button.item-title">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.item-status">
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource AppBadgeBackground}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.item-status TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.item-status.installed">
        <Setter Property="Background" Value="{DynamicResource StatusSuccessBackground}"/>
    </Style>
    <Style Selector="Border.item-status.installed TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessForeground}"/>
    </Style>
    <Style Selector="Border.item-status.update">
        <Setter Property="Background" Value="{DynamicResource WarningBannerBackground}"/>
    </Style>
    <Style Selector="Border.item-status.update TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningForeground}"/>
    </Style>
    <Style Selector="Border.library-error">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource StatusErrorBackground}"/>
    </Style>
    <Style Selector="Border.library-error TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorForeground}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TabStrip.library-tabs TabStripItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
</Styles>
