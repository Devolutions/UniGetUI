<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>$(SharedTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UniGetUI.AgentSkills.Cli</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>Skills</RootNamespace>
    <Version>1.7.0</Version>
    <Description>Agent skills command-line implementation for UniGetUI</Description>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Run the trim, AOT and single-file analyzers on every build. With
         warnings as errors, code that would break under NativeAOT or trimming
         fails `dotnet build`; ILLink and ILC inherit this on publish. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CLI command implementation is invoked in-process by UniGetUI. -->
    <ProjectReference Include="..\UniGetUI.AgentSkills\UniGetUI.AgentSkills.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
