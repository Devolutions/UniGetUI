<dialogs:ImmersiveDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:dialogs="using:UniGetUI.Avalonia.Views.DialogPages"
        xmlns:controls="using:UniGetUI.Avalonia.Views.Controls"
        xmlns:pvm="using:UniGetUI.Avalonia.ViewModels.Pages.SettingsPages.PolicyEditor"
        xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="UniGetUI.Avalonia.Views.Pages.SettingsPages.PolicyEditor.PolicyEditorDialog"
        x:DataType="pvm:PolicyEditorDialogViewModel"
        Title="{Binding Title}"
        MaxWidth="920"
        MinWidth="620"
        MaxHeight="900"
        MinHeight="480"
        Background="{DynamicResource AppDialogBackground}"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">

    <dialogs:ImmersiveDialog.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Session.SaveCommand}"/>
        <KeyBinding Gesture="Meta+S" Command="{Binding Session.SaveCommand}"/>
    </dialogs:ImmersiveDialog.KeyBindings>

    <dialogs:ImmersiveDialog.Styles>
        <Style Selector="Border.policy-section">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4,12,4,4"/>
        </Style>
        <Style Selector="TextBox.list-field">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="90"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="CheckBox.enum-option">
            <Setter Property="Margin" Value="0,0,16,6"/>
        </Style>
        <Style Selector="TextBlock.finding-error">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        </Style>
        <Style Selector="TextBlock.finding-warning">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        </Style>
        <Style Selector="TextBox.finding-error, ComboBox.finding-error">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="TextBox.finding-warning-target, ComboBox.finding-warning-target, CheckBox.finding-warning-target">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.policy-advisory">
            <Setter Property="Background" Value="{DynamicResource WarningBannerBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBannerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </dialogs:ImmersiveDialog.Styles>

    <dialogs:ImmersiveDialog.Resources>
        <DataTemplate x:Key="InlineFindingTemplate"
                      x:DataType="pvm:PolicyValidationFinding">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Classes.finding-error="{Binding IsError}"
                       Classes.finding-warning="{Binding IsWarning}"
                       automation:AutomationProperties.Name="{Binding AutomationName}"/>
        </DataTemplate>
        <DataTemplate x:Key="PolicyAdvisoryTemplate" x:DataType="x:String">
            <Border Classes="policy-advisory"
                    automation:AutomationProperties.Name="{Binding}"
                    automation:AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/warning_round.svg"
                                      Width="16"
                                      Height="16"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource WarningBannerBorderBrush}"
                                      automation:AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </dialogs:ImmersiveDialog.Resources>

    <dialogs:ImmersiveDialog.DataTemplates>
        <DataTemplate DataType="pvm:PolicyEditorEnumOption" x:DataType="pvm:PolicyEditorEnumOption">
            <StackPanel>
                <CheckBox Classes="enum-option"
                          Content="{Binding Display}"
                          IsChecked="{Binding IsSelected}"
                          controls:PolicyHelp.Text="{Binding HelpText}"
                          automation:AutomationProperties.Name="{Binding Display}"/>
                <ContentControl Content="{Binding AdvisoryText}"
                                ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                IsVisible="{Binding IsAdvisoryVisible}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="pvm:PolicyValidationFinding" x:DataType="pvm:PolicyValidationFinding">
            <Border Classes="settings-card"
                    Padding="10,6"
                    Margin="0,0,0,4"
                    Focusable="True"
                    automation:AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding SeverityText}"
                                   Classes.finding-error="{Binding IsError}"
                                   Classes.finding-warning="{Binding IsWarning}"
                                   FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FriendlyLocation}" Opacity="0.75"/>
                            <TextBlock Text="{Binding Pointer}"
                                       IsVisible="{Binding HasRawPointer}"
                                       Opacity="0.55"
                                       FontFamily="Consolas,Cascadia Mono,Menlo,monospace"
                                       FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="{t:Translate Go to field}"
                                Click="FindingNavigateButton_Click"
                                controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.GoToFinding}"
                                automation:AutomationProperties.Name="{t:Translate Go to affected policy field}"/>
                    </Grid>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </dialogs:ImmersiveDialog.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,12,20,16" RowSpacing="10">

        <controls:InfoBar Grid.Row="0"
                          DataContext="{Binding Status}"/>

        <Border Grid.Row="1"
                Classes="settings-card"
                IsVisible="{Binding HasFindingSummary}"
                Padding="10,8"
                automation:AutomationProperties.LiveSetting="Polite">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding FindingCountText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedFindingMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="{t:Translate Previous}"
                        IsVisible="{Binding HasMultipleFindings}"
                        IsEnabled="{Binding CanNavigateFinding}"
                        Click="PreviousFindingButton_Click"
                        automation:AutomationProperties.Name="{t:Translate Previous validation finding}"/>
                <Button Grid.Column="3"
                        Content="{t:Translate Next}"
                        IsVisible="{Binding HasMultipleFindings}"
                        IsEnabled="{Binding CanNavigateFinding}"
                        Click="NextFindingButton_Click"
                        automation:AutomationProperties.Name="{t:Translate Next validation finding}"/>
                <Button Grid.Column="4"
                        Content="{t:Translate Go to field}"
                        IsEnabled="{Binding CanNavigateFinding}"
                        Click="TopFindingNavigateButton_Click"
                        controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.GoToFinding}"
                        automation:AutomationProperties.Name="{t:Translate Go to affected policy field}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="StructuredModeButton" Grid.Column="0"
                    Content="{t:Translate Structured}"
                    Classes.accent="{Binding Session.IsStructuredMode}"
                    Classes="secondary-action"
                    IsEnabled="{Binding Session.CanSwitchToStructured}"
                    Click="StructuredModeButton_Click"
                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.StructuredMode}"
                    automation:AutomationProperties.Name="{t:Translate Switch to the structured editor}"/>
            <Button x:Name="RawModeButton" Grid.Column="1"
                    Content="{t:Translate Raw JSON}"
                    Classes.accent="{Binding Session.IsRawMode}"
                    Classes="secondary-action"
                    IsEnabled="{Binding Session.CanSwitchToRaw}"
                    Click="RawModeButton_Click"
                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RawMode}"
                    automation:AutomationProperties.Name="{t:Translate Switch to the raw JSON editor}"/>
            <TextBlock Grid.Column="3" Text="{t:Translate Unsaved changes}"
                       IsVisible="{Binding Session.IsDirty}"
                       VerticalAlignment="Center" Opacity="0.7"/>
        </Grid>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="2,0,2,8">

                <!-- ── Structured mode ── -->
                <StackPanel IsVisible="{Binding Session.IsStructuredMode}" Spacing="16">

                    <TextBlock Classes="section-heading" Text="{t:Translate Policy metadata}"
                               automation:AutomationProperties.HeadingLevel="2"/>
                    <Border Classes="settings-card policy-section">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                <TextBlock Classes="field-label"
                                           Text="{t:Translate Policy ID}"
                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PolicyId}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBox x:Name="PolicyIdInput"
                                             Text="{Binding Document.Id}"
                                             Tag="/Metadata/Id"
                                             IsEnabled="{Binding !Document.IsIdentityLocked}"
                                             Classes.finding-error="{Binding Document.HasIdErrors}"
                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PolicyId}"
                                             automation:AutomationProperties.Name="{t:Translate Policy ID}"/>
                                    <TextBlock Text="{x:Static pvm:PolicyEditorHelp.PolicyId}"
                                              TextWrapping="Wrap"
                                              Opacity="0.7"/>
                                    <ItemsControl ItemsSource="{Binding Document.IdFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                <TextBlock Classes="field-label" Text="{t:Translate Publisher}"
                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Publisher}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBox Text="{Binding Document.Publisher}"
                                             Tag="/Metadata/Publisher"
                                             Classes.finding-error="{Binding Document.HasPublisherErrors}"
                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Publisher}"
                                             automation:AutomationProperties.Name="{t:Translate Publisher}"/>
                                    <ItemsControl ItemsSource="{Binding Document.PublisherFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                <TextBlock Classes="field-label" Text="{t:Translate Policy format version}"
                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PolicyFormatVersion}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Document.PolicyFormatVersion}"
                                               Tag="/PolicyFormatVersion"
                                               Classes.finding-error="{Binding Document.HasPolicyFormatVersionErrors}"
                                               VerticalAlignment="Center"
                                               Focusable="True"
                                               controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PolicyFormatVersion}"
                                               automation:AutomationProperties.Name="{t:Translate Policy format version}"/>
                                    <ItemsControl ItemsSource="{Binding Document.PolicyFormatVersionFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                <CheckBox Content="{t:Translate Description}"
                                         IsChecked="{Binding Document.HasDescription}"
                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Description}"
                                         automation:AutomationProperties.Name="{t:Translate Description}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBox Classes="list-field"
                                             Classes.finding-error="{Binding Document.HasDescriptionErrors}"
                                             Text="{Binding Document.Description}"
                                             Tag="/Metadata/Description"
                                             IsEnabled="{Binding Document.HasDescription}"
                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Description}"
                                             automation:AutomationProperties.Name="{t:Translate Description}"/>
                                    <ItemsControl ItemsSource="{Binding Document.DescriptionFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                <TextBlock Classes="field-label" Text="{t:Translate Support URL}"
                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.SupportUrl}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBox Text="{Binding Document.SupportUrl}"
                                             Tag="/Metadata/SupportUrl"
                                             Classes.finding-error="{Binding Document.HasSupportUrlErrors}"
                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.SupportUrl}"
                                             automation:AutomationProperties.Name="{t:Translate Support URL}"/>
                                    <ItemsControl ItemsSource="{Binding Document.SupportUrlFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                <TextBlock Classes="field-label" Text="{t:Translate Valid from}"
                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidFrom}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <WrapPanel Orientation="Horizontal"
                                               Tag="/Metadata/ValidFrom"
                                               controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidFrom}">
                                        <DatePicker SelectedDate="{Binding Document.ValidFromDate, Mode=TwoWay}"
                                                    MinWidth="220"
                                                    Margin="0,0,12,8"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidFrom}"
                                                    automation:AutomationProperties.Name="{t:Translate Valid from date}"/>
                                        <TimePicker SelectedTime="{Binding Document.ValidFromTime, Mode=TwoWay}"
                                                    ClockIdentifier="24HourClock"
                                                    MinWidth="150"
                                                    Margin="0,0,12,8"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidFrom}"
                                                    automation:AutomationProperties.Name="{t:Translate Valid from time}"/>
                                        <Button Content="{t:Translate Clear}"
                                                Command="{Binding Document.ClearValidFromCommand}"
                                                Margin="0,0,0,8"
                                                automation:AutomationProperties.Name="{t:Translate Clear Valid from}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Document.ValidFromError}"
                                               IsVisible="{Binding Document.ValidFromError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Classes="finding-error"
                                               TextWrapping="Wrap"
                                               automation:AutomationProperties.LiveSetting="Assertive"/>
                                    <ItemsControl ItemsSource="{Binding Document.ValidFromFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                <TextBlock Classes="field-label" Text="{t:Translate Valid until}"
                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidUntil}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <WrapPanel Orientation="Horizontal"
                                               Tag="/Metadata/ValidUntil"
                                               controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidUntil}">
                                        <DatePicker SelectedDate="{Binding Document.ValidUntilDate, Mode=TwoWay}"
                                                    MinWidth="220"
                                                    Margin="0,0,12,8"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidUntil}"
                                                    automation:AutomationProperties.Name="{t:Translate Valid until date}"/>
                                        <TimePicker SelectedTime="{Binding Document.ValidUntilTime, Mode=TwoWay}"
                                                    ClockIdentifier="24HourClock"
                                                    MinWidth="150"
                                                    Margin="0,0,12,8"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ValidUntil}"
                                                    automation:AutomationProperties.Name="{t:Translate Valid until time}"/>
                                        <Button Content="{t:Translate Clear}"
                                                Command="{Binding Document.ClearValidUntilCommand}"
                                                Margin="0,0,0,8"
                                                automation:AutomationProperties.Name="{t:Translate Clear Valid until}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Document.ValidUntilError}"
                                               IsVisible="{Binding Document.ValidUntilError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Classes="finding-error"
                                               TextWrapping="Wrap"
                                               automation:AutomationProperties.LiveSetting="Assertive"/>
                                    <ItemsControl ItemsSource="{Binding Document.ValidUntilFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Document.LocalTimeZoneText}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       automation:AutomationProperties.Name="{t:Translate Validity time zone}"/>
                            <ContentControl Content="{Binding Document.ValidityWindowAdvisory}"
                                            ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                            IsVisible="{Binding Document.IsOutsideValidityWindow}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-heading" Text="{t:Translate Enforcement}"
                               automation:AutomationProperties.HeadingLevel="2"/>

                    <Expander IsExpanded="{Binding Document.HasEnforcementAdvisory}"
                              Margin="40,0,40,0"
                              automation:AutomationProperties.Name="{t:Translate Advanced policy settings}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{t:Translate Advanced}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Document.EnforcementAdvisoryCountText}"
                                           IsVisible="{Binding Document.HasEnforcementAdvisory}"
                                           Classes="finding-warning"/>
                            </StackPanel>
                        </Expander.Header>
                        <Border Classes="settings-card policy-section" Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                    <TextBlock Classes="field-label" Text="{t:Translate Default decision}"
                                               controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.DefaultDecision}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <ComboBox ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.DecisionDisplayItems}"
                                                  SelectedIndex="{Binding Document.DecisionIndex}"
                                                  Tag="/Enforcement/DefaultDecision"
                                                  Classes.finding-error="{Binding Document.HasDefaultDecisionErrors}"
                                                  controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.DefaultDecision}"
                                                  automation:AutomationProperties.Name="{t:Translate Default decision}"/>
                                        <ItemsControl ItemsSource="{Binding Document.DefaultDecisionFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                        <ContentControl Content="{x:Static pvm:PolicyEditorHelp.DefaultAllowAdvisory}"
                                                        ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                        IsVisible="{Binding Document.IsDefaultAllow}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                    <TextBlock Classes="field-label"
                                               Text="{t:Translate Audit mode}"
                                               controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AuditMode}"/>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <ComboBox ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.AuditModeDisplayItems}"
                                                  SelectedIndex="{Binding Document.AuditModeIndex}"
                                                  Tag="/Enforcement/AuditMode"
                                                  Classes.finding-error="{Binding Document.HasAuditModeErrors}"
                                                  controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AuditMode}"
                                                  automation:AutomationProperties.Name="{t:Translate Audit mode}"/>
                                        <ContentControl Content="{x:Static pvm:PolicyEditorHelp.AuditModeWarning}"
                                                        ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                        IsVisible="{Binding Document.IsAuditModeEnabled}"/>
                                        <ItemsControl ItemsSource="{Binding Document.AuditModeFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Grid x:Name="RulesSectionHeader"
                          ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          HorizontalAlignment="Left">
                        <TextBlock Classes="section-heading" Text="{t:Translate Rules}"
                                   automation:AutomationProperties.HeadingLevel="2"/>
                        <Button Grid.Column="1" Content="{t:Translate Add rule}"
                                Click="AddRuleButton_Click"
                                VerticalAlignment="Center"
                                Margin="0,8,0,0"
                                controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AddRule}"
                                automation:AutomationProperties.Name="{t:Translate Add rule}"/>
                    </Grid>

                    <TextBlock Text="{t:Translate This policy has no rules yet.}"
                               IsVisible="{Binding !Rules.Count}"
                               Opacity="0.7" Margin="4,0"/>

                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pvm:PolicyEditorRuleUi">
                                <Expander Margin="0,0,0,10"
                                          Focusable="True"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          automation:AutomationProperties.Name="{Binding AutomationName}">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center"
                                                      Tag="/Rules/*/Enabled"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RuleEnabled}"
                                                      automation:AutomationProperties.Name="{t:Translate Rule enabled}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AutomationName}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Classes="secondary-action" Content="{t:Translate Duplicate}"
                                                    Click="DuplicateRuleButton_Click"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.DuplicateRule}"
                                                    automation:AutomationProperties.Name="{t:Translate Duplicate rule}"/>
                                            <Button Grid.Column="3" Classes="secondary-action" Content="{t:Translate Move up}"
                                                    Click="MoveRuleUpButton_Click"
                                                    IsEnabled="{Binding CanMoveUp}"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.MoveRule}"
                                                    automation:AutomationProperties.Name="{t:Translate Move rule up}"/>
                                            <Button Grid.Column="4" Classes="secondary-action" Content="{t:Translate Move down}"
                                                    Click="MoveRuleDownButton_Click"
                                                    IsEnabled="{Binding CanMoveDown}"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.MoveRule}"
                                                    automation:AutomationProperties.Name="{t:Translate Move rule down}"/>
                                            <Button Grid.Column="5" Classes="secondary-action" Content="{t:Translate Delete}"
                                                    Click="DeleteRuleButton_Click"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.DeleteRule}"
                                                    automation:AutomationProperties.Name="{t:Translate Delete rule}"/>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Margin="12,8,4,12" Spacing="8">

                                        <ItemsControl ItemsSource="{Binding Findings}" IsVisible="{Binding HasFindings}"/>

                                        <Border Classes="settings-card"
                                                IsVisible="{Binding IsDisabled}"
                                                Padding="8"
                                                controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.DisabledRuleHint}"
                                                automation:AutomationProperties.Name="{t:Translate Disabled rule notice}">
                                            <TextBlock Text="{x:Static pvm:PolicyEditorHelp.DisabledRuleHint}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <ContentControl Content="{x:Static pvm:PolicyEditorHelp.UnrestrictedRuleWarning}"
                                                        ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                        IsVisible="{Binding IsEnabledWithoutMatchConditions}"/>

                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label"
                                                       Text="{t:Translate Rule ID}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RuleId}"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBox Text="{Binding Id}"
                                                         Tag="/Rules/*/Id"
                                                         Classes.finding-error="{Binding HasIdErrors}"
                                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RuleId}"
                                                         automation:AutomationProperties.Name="{t:Translate Rule ID}"/>
                                                <TextBlock Text="{x:Static pvm:PolicyEditorHelp.RuleId}"
                                                          TextWrapping="Wrap"
                                                          Opacity="0.7"/>
                                                <ItemsControl ItemsSource="{Binding IdFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Evaluation order}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Priority}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EvaluationOrder}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Priority}"
                                                       automation:AutomationProperties.Name="{t:Translate Evaluation order}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Decision}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Decision}"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <ComboBox ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.DecisionDisplayItems}"
                                                          SelectedIndex="{Binding DecisionIndex}"
                                                          SelectionChanged="RuleDecision_SelectionChanged"
                                                          Tag="/Rules/*/Decision"
                                                          Classes.finding-error="{Binding HasDecisionErrors}"
                                                          controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Decision}"
                                                          automation:AutomationProperties.Name="{t:Translate Decision}"/>
                                                <ItemsControl ItemsSource="{Binding DecisionFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <CheckBox Content="{t:Translate Reason}"
                                                     IsChecked="{Binding HasReason}"
                                                     controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RuleReason}"
                                                     automation:AutomationProperties.Name="{t:Translate Reason}"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBox Classes="list-field"
                                                         Classes.finding-error="{Binding HasReasonErrors}"
                                                         Text="{Binding Reason}"
                                                         Tag="/Rules/*/Reason"
                                                         IsEnabled="{Binding HasReason}"
                                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RuleReason}"
                                                         automation:AutomationProperties.Name="{t:Translate Reason}"/>
                                                <ItemsControl ItemsSource="{Binding ReasonFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Classes="section-heading"
                                                   Classes.finding-error="{Binding HasMatchErrors}"
                                                   Text="{t:Translate Match criteria}"
                                                   Tag="/Rules/*/Match"
                                                   Focusable="True"
                                                   controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RequestCharacteristics}"
                                                   automation:AutomationProperties.HeadingLevel="3"/>
                                        <ItemsControl ItemsSource="{Binding MatchFindings}"
                                                      ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                        <Border Classes="settings-card"
                                                IsVisible="{Binding IsIncompleteNewRule}"
                                                Padding="8"
                                                controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.IncompleteRuleHint}">
                                            <TextBlock Text="{x:Static pvm:PolicyEditorHelp.IncompleteRuleHint}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding RuleSafetyAdvisories}"
                                                      IsVisible="{Binding HasRuleSafetyAdvisories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                                    Margin="0,0,0,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Classes="field-label"
                                                   Text="{t:Translate Operations (optional)}"
                                                   controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Operations}"/>
                                        <ItemsControl ItemsSource="{Binding OperationOptions}"
                                                      Tag="/Rules/*/Match/Operations"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Operations}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <TextBlock Classes="field-label"
                                                   Text="{t:Translate Package managers (optional)}"
                                                   controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Managers}"/>
                                        <ItemsControl ItemsSource="{Binding ManagerOptions}"
                                                      Tag="/Rules/*/Match/Managers"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Managers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <TextBlock Classes="field-label"
                                                   Text="{t:Translate Scopes (optional)}"
                                                   controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Scopes}"/>
                                        <ItemsControl ItemsSource="{Binding ScopeOptions}"
                                                      Tag="/Rules/*/Match/Scopes"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Scopes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <TextBlock Classes="field-label"
                                                   Text="{t:Translate Architectures (optional)}"
                                                   controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Architectures}"/>
                                        <ItemsControl ItemsSource="{Binding ArchitectureOptions}"
                                                      Tag="/Rules/*/Match/Architectures"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Architectures}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <TextBlock Classes="field-label"
                                                   Text="{t:Translate Execution privilege (optional)}"
                                                   controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ExecutionPrivilege}"/>
                                        <ItemsControl ItemsSource="{Binding ExecutionElevationOptions}"
                                                      Tag="/Rules/*/Match/ExecutionElevation"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ExecutionPrivilege}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Source names (one per line; optional)}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.SourceNames}"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBox Classes="list-field" Text="{Binding SourceNames}"
                                                         IsVisible="{Binding IsSourceNamesVisible}"
                                                         Tag="/Rules/*/Match/SourceNames"
                                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.SourceNames}"
                                                         automation:AutomationProperties.Name="{t:Translate Source names}"/>
                                                <TextBlock IsVisible="{Binding !IsSourceNamesVisible}"
                                                           Text="{t:Translate Source names become available after selecting exactly one package manager that supports configured sources.}"
                                                           TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Package identifiers}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PackageIdentifiers}"/>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <ComboBox ItemsSource="{Binding PackageIdentifierModeItems}"
                                                          SelectedIndex="{Binding PackageIdentifierModeIndex}"
                                                          Tag="/Rules/*/Match/PackageIdentifiers"
                                                          controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PackageIdentifiers}"
                                                          automation:AutomationProperties.Name="{t:Translate Package identifier match mode}"/>
                                                <StackPanel IsVisible="{Binding IsExactPackageIdentifierMode}" Spacing="2">
                                                    <TextBox Classes="list-field"
                                                             Classes.finding-error="{Binding HasExactPackageIdentifierErrors}"
                                                             Text="{Binding ExactPackageIdentifiers}"
                                                             Tag="/Rules/*/Match/PackageIdentifiers/Exact"
                                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ExactPackageIdentifiers}"
                                                             automation:AutomationProperties.Name="{t:Translate Exact package identifiers}"/>
                                                    <TextBlock Text="{t:Translate Exact identifiers match complete package identifiers literally; wildcard characters have no special meaning.}"
                                                               TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
                                                    <ItemsControl ItemsSource="{Binding ExactPackageIdentifierFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding IsPackageIdentifierPatternMode}" Spacing="2">
                                                    <TextBox Classes="list-field"
                                                             Classes.finding-error="{Binding HasPackageIdentifierPatternErrors}"
                                                             Text="{Binding PackageIdentifierPatterns}"
                                                             Tag="/Rules/*/Match/PackageIdentifiers/Patterns"
                                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PackageIdentifierPatterns}"
                                                             automation:AutomationProperties.Name="{t:Translate Package identifier patterns}"/>
                                                    <TextBlock Text="{t:Translate Text='Patterns may match multiple packages. Use * for any characters and ? for one character; for example, Contoso.*.'}"
                                                               TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
                                                    <ItemsControl ItemsSource="{Binding PackageIdentifierPatternFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Package versions}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PackageVersion}"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding PackageVersionModeItems}"
                                                      SelectedIndex="{Binding PackageVersionModeIndex}"
                                                      Tag="/Rules/*/Match/Version"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PackageVersion}"
                                                      automation:AutomationProperties.Name="{t:Translate Package versions match mode}"/>
                                        </Grid>
                                        <StackPanel IsVisible="{Binding IsExactVersionMode}" Spacing="2" Margin="24,0,0,0">
                                            <TextBox Classes="list-field"
                                                     Classes.finding-error="{Binding HasExactVersionErrors}"
                                                     Text="{Binding ExactVersions}"
                                                     Tag="/Rules/*/Match/Version/Exact"
                                                     controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.ExactVersions}"
                                                     automation:AutomationProperties.Name="{t:Translate Exact package versions}"/>
                                            <TextBlock Text="{t:Translate Text='Exact versions match any package version value literally, including versions that are not semantic versions.'}"
                                                       TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
                                            <ItemsControl ItemsSource="{Binding ExactVersionFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsVersionRangeMode}" Spacing="8" Margin="24,0,0,0">
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Classes="field-label" Text="{t:Translate Minimum version}"
                                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.MinimumVersion}"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBox Text="{Binding MinVersion}"
                                                             Tag="/Rules/*/Match/Version/Range/MinVersion"
                                                             Classes.finding-error="{Binding HasMinVersionErrors}"
                                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.MinimumVersion}"
                                                             automation:AutomationProperties.Name="{t:Translate Minimum version}"/>
                                                    <ItemsControl ItemsSource="{Binding MinVersionFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Classes="field-label" Text="{t:Translate Maximum version}"
                                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.MaximumVersion}"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBox Text="{Binding MaxVersion}"
                                                             Tag="/Rules/*/Match/Version/Range/MaxVersion"
                                                             Classes.finding-error="{Binding HasMaxVersionErrors}"
                                                             controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.MaximumVersion}"
                                                             automation:AutomationProperties.Name="{t:Translate Maximum version}"/>
                                                    <ItemsControl ItemsSource="{Binding MaxVersionFindings}" ItemTemplate="{StaticResource InlineFindingTemplate}"/>
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Content="{t:Translate Include prerelease versions}"
                                                      IsChecked="{Binding IncludePrerelease}"
                                                      Tag="/Rules/*/Match/Version/Range/IncludePrerelease"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.IncludePrerelease}"/>
                                        </StackPanel>

                                        <TextBlock Classes="section-heading"
                                                   Text="{t:Translate Request characteristics}"
                                                   controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RequestCharacteristics}"
                                                   automation:AutomationProperties.HeadingLevel="3"/>

                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Interactive}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.InteractiveMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding InteractiveIndex}"
                                                      Tag="/Rules/*/Match/Interactive"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.InteractiveMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Interactive}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Skip hash check}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.SkipHashMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding SkipHashCheckIndex}"
                                                      Tag="/Rules/*/Match/SkipHashCheck"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.SkipHashMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Skip hash check}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Prerelease}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PrereleaseMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding PreReleaseIndex}"
                                                      Tag="/Rules/*/Match/PreRelease"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PrereleaseMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Prerelease}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Custom parameters}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.CustomParametersMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding HasCustomParametersIndex}"
                                                      Tag="/Rules/*/Match/HasCustomParameters"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.CustomParametersMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Custom parameters}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Custom install location}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.CustomLocationMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding HasCustomInstallLocationIndex}"
                                                      Tag="/Rules/*/Match/HasCustomInstallLocation"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.CustomLocationMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Custom install location}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Pre/post commands}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PrePostCommandsMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding HasPrePostCommandsIndex}"
                                                      Tag="/Rules/*/Match/HasPrePostCommands"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.PrePostCommandsMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Pre/post commands}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Stop running apps before operation}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.KillBeforeMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding HasKillBeforeOperationIndex}"
                                                      Tag="/Rules/*/Match/HasKillBeforeOperation"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.KillBeforeMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Stop running apps before operation}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                            <TextBlock Classes="field-label" Text="{t:Translate Uninstall previous version}"
                                                       controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.UninstallPreviousMatch}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static pvm:PolicyEditorEnumDisplay.TriStateDisplayItems}"
                                                      SelectedIndex="{Binding HasUninstallPreviousIndex}"
                                                      Tag="/Rules/*/Match/HasUninstallPrevious"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.UninstallPreviousMatch}"
                                                      automation:AutomationProperties.Name="{t:Translate Uninstall previous version}"/>
                                        </Grid>

                                        <Expander IsVisible="{Binding IsAllowDecision}"
                                                  IsExpanded="True"
                                                  Tag="/Rules/*/ConstraintsSection"
                                                  controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Constraints}">
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="section-heading"
                                                               Text="{t:Translate Additional safety limits}"
                                                               controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Constraints}"
                                                               automation:AutomationProperties.HeadingLevel="3"/>
                                                    <TextBlock Grid.Column="1"
                                                               IsVisible="{Binding HasFieldSafetyAdvisories}"
                                                               Text="{Binding FieldSafetyAdvisoryCountText}"
                                                               Classes="finding-warning"
                                                               VerticalAlignment="Center"
                                                               automation:AutomationProperties.Name="{Binding FieldSafetyAdvisoryCountText}"
                                                               automation:AutomationProperties.LiveSetting="Polite"/>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Spacing="6" Margin="24,0,0,0">
                                                <CheckBox Content="{t:Translate Add safety limits to this Allow rule}"
                                                          IsChecked="{Binding HasConstraints}"
                                                          Tag="/Rules/*/Constraints"
                                                          controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Constraints}"/>
                                                <StackPanel IsVisible="{Binding HasConstraints}" Spacing="6">
                                            <CheckBox Content="{t:Translate Allow interactive installs}" IsChecked="{Binding AllowInteractive}"
                                                      Tag="/Rules/*/Constraints/AllowInteractive"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowInteractive}"/>
                                            <CheckBox Content="{t:Translate Allow skipping the hash check}" IsChecked="{Binding AllowSkipHashCheck}"
                                                      Tag="/Rules/*/Constraints/AllowSkipHashCheck"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowSkipHashCheck}"/>
                                            <ContentControl Content="{Binding SkipHashCheckAdvisory}"
                                                            ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                            IsVisible="{Binding HasSkipHashCheckAdvisory}"/>
                                            <CheckBox Content="{t:Translate Allow prerelease packages}" IsChecked="{Binding AllowPreRelease}"
                                                      Tag="/Rules/*/Constraints/AllowPreRelease"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowPrerelease}"/>
                                            <CheckBox Content="{t:Translate Allow a custom install location}" IsChecked="{Binding AllowCustomInstallLocation}"
                                                      Tag="/Rules/*/Constraints/AllowCustomInstallLocation"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowCustomLocation}"/>
                                            <ContentControl Content="{Binding CustomInstallLocationAdvisory}"
                                                            ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                            IsVisible="{Binding HasCustomInstallLocationAdvisory}"/>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Classes="field-label" Text="{t:Translate Allowed install location patterns}"
                                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.LocationPatterns}"/>
                                                <TextBox Classes="list-field" Grid.Column="1" Text="{Binding AllowedInstallLocationPatterns}"
                                                         Tag="/Rules/*/Constraints/AllowedInstallLocationPatterns"
                                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.LocationPatterns}"
                                                         automation:AutomationProperties.Name="{t:Translate Allowed install location patterns}"/>
                                            </Grid>
                                            <CheckBox Content="{t:Translate Allow custom parameters}" IsChecked="{Binding AllowCustomParameters}"
                                                      Tag="/Rules/*/Constraints/AllowCustomParameters"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowCustomParameters}"/>
                                            <ContentControl Content="{Binding CustomParametersAdvisory}"
                                                            ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                            IsVisible="{Binding HasCustomParametersAdvisory}"/>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Classes="field-label" Text="{t:Translate Allowed custom parameters}"
                                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowedParameters}"/>
                                                <TextBox Classes="list-field" Grid.Column="1" Text="{Binding AllowedCustomParameters}"
                                                         Tag="/Rules/*/Constraints/AllowedCustomParameters"
                                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowedParameters}"
                                                         automation:AutomationProperties.Name="{t:Translate Allowed custom parameters}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Classes="field-label" Text="{t:Translate Allowed custom parameter patterns}"
                                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowedParameterPatterns}"/>
                                                <TextBox Classes="list-field" Grid.Column="1" Text="{Binding AllowedCustomParameterPatterns}"
                                                         Tag="/Rules/*/Constraints/AllowedCustomParameterPatterns"
                                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowedParameterPatterns}"
                                                         automation:AutomationProperties.Name="{t:Translate Allowed custom parameter patterns}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Classes="field-label" Text="{t:Translate Denied custom parameters}"
                                                           controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.DeniedParameters}"/>
                                                <TextBox Classes="list-field" Grid.Column="1" Text="{Binding DeniedCustomParameters}"
                                                         Tag="/Rules/*/Constraints/DeniedCustomParameters"
                                                         controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.DeniedParameters}"
                                                         automation:AutomationProperties.Name="{t:Translate Denied custom parameters}"/>
                                            </Grid>
                                            <CheckBox Content="{t:Translate Allow pre/post commands}" IsChecked="{Binding AllowPrePostCommands}"
                                                      Tag="/Rules/*/Constraints/AllowPrePostCommands"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowPrePostCommands}"/>
                                            <ContentControl Content="{Binding PrePostCommandsAdvisory}"
                                                            ContentTemplate="{StaticResource PolicyAdvisoryTemplate}"
                                                            IsVisible="{Binding HasPrePostCommandsAdvisory}"/>
                                            <CheckBox Content="{t:Translate Allow kill-before-operation}" IsChecked="{Binding AllowKillBeforeOperation}"
                                                      Tag="/Rules/*/Constraints/AllowKillBeforeOperation"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowKillBefore}"/>
                                            <CheckBox Content="{t:Translate Allow uninstalling a previous version}" IsChecked="{Binding AllowUninstallPrevious}"
                                                      Tag="/Rules/*/Constraints/AllowUninstallPrevious"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowUninstallPrevious}"/>
                                            <CheckBox Content="{t:Translate Allow upgrades}" IsChecked="{Binding AllowUpgrade}"
                                                      Tag="/Rules/*/Constraints/AllowUpgrade"
                                                      controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.AllowUpgrade}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Raw JSON mode ── -->
                <StackPanel IsVisible="{Binding Session.IsRawMode}" Spacing="8">
                    <TextBlock Text="{t:Translate Edit the complete policy as JSON. Valid structure is required to return to guided fields; policy errors remain available there for correction.}"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <Border Classes="settings-card policy-section" Padding="0">
                        <controls:PolicyJsonEditor x:Name="RawEditor" MinHeight="360" MaxHeight="640"
                                                    TextChanged="RawEditor_TextChanged"
                                                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.RawMode}"
                                                    automation:AutomationProperties.Name="{t:Translate Raw policy JSON}"/>
                    </Border>
                    <TextBlock Text="{Binding Session.SyntaxErrorMessage}"
                               IsVisible="{Binding Session.SyntaxError, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Classes="finding-error"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="{t:Translate Raw JSON syntax error}"
                               automation:AutomationProperties.HelpText="{Binding Session.SyntaxError.Pointer}"
                               automation:AutomationProperties.LiveSetting="Assertive"/>
                    <Button Content="{t:Translate Go to JSON error}"
                            IsVisible="{Binding Session.SyntaxError, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Click="RawSyntaxNavigateButton_Click"
                            HorizontalAlignment="Left"
                            controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.GoToRawError}"
                            automation:AutomationProperties.Name="{t:Translate Go to raw JSON error}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding WriteFailureMessage}" IsVisible="{Binding HasWriteFailure}"
                       Classes="finding-error" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{t:Translate Overwrite}"
                    Command="{Binding Session.ConfirmOverwriteCommand}"
                    IsVisible="{Binding Session.HasConflict}"
                    IsEnabled="{Binding Session.CanValidateOrSave}"
                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Overwrite}"
                    automation:AutomationProperties.Name="{t:Translate Overwrite the policy that changed elsewhere}"/>
            <Button Grid.Column="2" Classes="accent" Content="{t:Translate Save}"
                    Command="{Binding Session.SaveCommand}"
                    IsEnabled="{Binding Session.CanValidateOrSave}"
                    controls:PolicyHelp.Text="{x:Static pvm:PolicyEditorHelp.Save}"
                    automation:AutomationProperties.Name="{t:Translate Save policy}"/>
            <Button Grid.Column="3" Content="{t:Translate Close}"
                    Click="CloseButton_Click"
                    automation:AutomationProperties.Name="{t:Translate Close policy editor}"/>
        </Grid>
    </Grid>
</dialogs:ImmersiveDialog>
