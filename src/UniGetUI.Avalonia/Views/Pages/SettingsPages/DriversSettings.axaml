<UserControl x:Class="UniGetUI.Avalonia.Views.Pages.SettingsPages.DriversSettings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:vm="using:UniGetUI.Avalonia.ViewModels.Pages.SettingsPages"
             xmlns:settings="using:UniGetUI.Avalonia.Views.Controls.Settings"
             xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:DataType="vm:DriversSettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,10">
        <StackPanel Orientation="Vertical">

            <settings:CheckboxCard x:Name="DriversCard"
                                   SettingName="EnableDrivers"
                                   Text="{t:Translate Enable Drivers}"
                                   Description="{t:Translate Text='Lists the driver updates that Windows Update offers for this computer, including the optional ones, and installs the ones you pick.'}"
                                   StateChangedCommand="{Binding EnabledChangedCommand}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   CornerRadius="8"/>

            <settings:TranslatedTextBlock Text="Requirements"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Margin="44,32,4,8"
                                          automation:AutomationProperties.HeadingLevel="2"/>

            <settings:SettingsCard x:Name="DriversElevationCard"
                                   CornerRadius="8,8,0,0"
                                   Header="{t:Translate Administrator rights}"
                                   Description="{Binding ElevationStatus}"/>

            <settings:ButtonCard x:Name="OpenDriversCard"
                                 Text="{t:Translate See the available driver updates}"
                                 ButtonText="{t:Translate Open Drivers}"
                                 Command="{Binding OpenCommand}"
                                 IsEnabled="{Binding IsEnabled}"
                                 BorderThickness="1,0,1,1"
                                 CornerRadius="0,0,8,8"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
